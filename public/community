<script>
        // Simple micro-interaction for the voice button
        document.querySelector('.voice-pulse').addEventListener('click', function() {
            const icon = this.querySelector('.material-symbols-outlined');
            if (icon.innerText === 'mic') {
                icon.innerText = 'graphic_eq';
                this.style.backgroundColor = '#ba1a1a'; // Error color for recording state
            } else {
                icon.innerText = 'mic';
                this.style.backgroundColor = '#2e7d32'; // Primary color
            }
        });

        // Sticky header opacity scroll effect
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (window.scrollY > 20) {
                header.classList.add('shadow-md');
                header.classList.remove('shadow-sm');
            } else {
                header.classList.remove('shadow-md');
                header.classList.add('shadow-sm');
            }
        });
    </script>
